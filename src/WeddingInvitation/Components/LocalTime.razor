@inject BrowserService Browser

<time datetime="@Value.ToString("O")">@_label</time>

@code {
    [Parameter] public DateTimeOffset Value { get; set; }
    private DateTimeOffset? _rendered;
    private string _label = "Loading local time…";
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_rendered == Value) return;
        _rendered = Value;
        _label = await Browser.LocalDateAsync(Value);
        StateHasChanged();
    }
}
