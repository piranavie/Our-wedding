@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JS

@if (!Revealed)
{
    <div class="scratch ready" @ref="_surface" role="button" tabindex="0" aria-label="Scratch to reveal the wedding date, or press Enter or Space" aria-describedby="scratch-help">
        <canvas class="scratch-foil" aria-hidden="true"></canvas>
        <span class="scratch-hint" aria-hidden="true"><i class="scratch-finger"></i><span>A little moment of magic</span><strong>Gently scratch to reveal</strong></span>
    </div>
    <p id="scratch-help" class="sr-only">Move your finger or pointer across the gold foil. You can also use the Reveal date button below the card.</p>
}

@code {
    [Parameter] public bool Revealed { get; set; }
    [Parameter] public EventCallback OnReveal { get; set; }
    private ElementReference _surface;
    private IJSObjectReference? _module;
    private IJSObjectReference? _scratch;
    private DotNetObjectReference<ScratchReveal>? _reference;
    private bool _disposed;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposed) return;
        if (Revealed) { await ReleaseScratchAsync(); return; }
        if (_scratch is not null) return;
        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/original-design.js");
        if (_disposed) { await _module.DisposeAsync(); return; }
        _reference = DotNetObjectReference.Create(this);
        _scratch = await _module.InvokeAsync<IJSObjectReference>("attachScratch", _surface, _reference);
    }

    [JSInvokable]
    public async Task RevealAsync()
    {
        if (!_disposed && !Revealed) await OnReveal.InvokeAsync();
    }

    private async Task ReleaseScratchAsync()
    {
        if (_scratch is not null)
        {
            await _scratch.InvokeVoidAsync("dispose");
            await _scratch.DisposeAsync();
            _scratch = null;
        }
        _reference?.Dispose();
        _reference = null;
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        await ReleaseScratchAsync();
        if (_module is not null) await _module.DisposeAsync();
    }
}
