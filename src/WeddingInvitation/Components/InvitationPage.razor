@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject BrowserService Browser
@inject IJSRuntime JS

<a class="skip-link" href="#invitation-main" @onclick="FocusMainAsync" @onclick:preventDefault>Skip to invitation</a>
<div class="backdrop" aria-hidden="true"></div>
<div class="petals" @ref="_petals" aria-hidden="true">
    @for (var i = 0; i < 18; i++)
    {
        <i class="petal"></i>
    }
</div>
<div class="vignette" aria-hidden="true"></div>
<div class="original-wedding wedding-app">
    <div class="original-music"><MusicControl Config="Config" /></div>
    <main id="invitation-main" tabindex="-1" @ref="_presentation">
        <section class="stage @(_opened ? "is-open" : "") @(_cardsVisible ? "is-out" : "")" hidden="@(_screen != Screen.Cards)" aria-label="Wedding invitation">
            <p class="sr-only">@Config.WelcomeText</p>
            <div class="area">
                <OriginalEnvelope Image="@Config.SaveTheDateImage" Opening="_opened" OnOpen="OpenAsync" />
                @if (_cardsVisible)
                {
                    <div class="deck" @ontouchstart="TouchStart" @ontouchend="TouchEnd">
                        <figure class="card @(_card == 0 ? "current shine" : "gone")" data-label="Save the Date" hidden="@(_card != 0)">
                            @if (!string.IsNullOrWhiteSpace(Config.SaveTheDateImage))
                            {
                                <img src="@Config.SaveTheDateImage" alt="Save the Date for @Config.CoupleNames" draggable="false" />
                            }
                            else
                            {
                                <div class="artwork-fallback"><h2>Save the Date</h2><p>@Config.CoupleNames</p><LocalTime Value="Config.Wedding.Start" /></div>
                            }
                            <ScratchReveal Revealed="_dateRevealed" OnReveal="RevealDate" />
                            @if (_dateRevealed)
                            {
                                <figcaption id="reveal-status" class="sr-only" tabindex="-1" role="status">The date is revealed. Continue to your invitation.</figcaption>
                            }
                        </figure>
                        <figure class="card @(_card == 1 ? "current shine" : "behind")" data-label="Invitation" hidden="@(_card != 1)">
                            <h2 id="invitation-title" class="sr-only" tabindex="-1">Wedding invitation</h2>
                            @if (!string.IsNullOrWhiteSpace(Config.InvitationImage))
                            {
                                <button id="invitation-enlarge" class="artwork-open" type="button" aria-label="Enlarge the wedding invitation" aria-haspopup="dialog" aria-controls="invitation-viewer" @onclick="ShowViewerAsync" @ontouchstart:stopPropagation @ontouchend:stopPropagation>
                                    <img src="@Config.InvitationImage" alt="Wedding invitation for @Config.CoupleNames. Accessible event details and directions are on the Wedding details page." draggable="false" />
                                    <span class="zoom-hint" aria-hidden="true">⤢ Tap to enlarge</span>
                                </button>
                            }
                            else
                            {
                                <div class="artwork-fallback"><h2>@Config.CoupleNames</h2><p>@Config.BlessingText</p><LocalTime Value="Config.Wedding.Start" /><p>@Config.Wedding.VenueName</p></div>
                            }
                        </figure>
                    </div>
                }
            </div>
            @if (_cardsVisible)
            {
                <nav class="nav" aria-label="Invitation cards">
                    <button class="btn ghost" type="button" disabled="@(_card == 0)" @onclick="PreviousCard">‹ Back</button>
                    <div class="dots"><span id="card-label" tabindex="-1" aria-live="polite">@(_card == 0 ? "Save the Date" : "Invitation")</span><div aria-hidden="true"><i class="@(_card == 0 ? "on" : "")"></i><i class="@(_card == 1 ? "on" : "")"></i></div></div>
                    <button class="btn" type="button" @onclick="Next">@(_card == 0 ? (_dateRevealed ? "Invitation ›" : "Reveal date ›") : "Programme ›")</button>
                </nav>
                <div class="card-extras">
                    <button class="button-subtle" type="button" @onclick="OpenDetails">Wedding details &amp; RSVP</button>
                </div>
            }
        </section>
        <section class="programme-screen visible" hidden="@(_screen != Screen.Programme)" aria-labelledby="programme-title">
            <div class="programme-scroll">
                <header class="programme-hero">
                    <WeddingIllustration Kind="thaali" />
                    <p class="programme-kicker">தாலி கட்டு · Thaali ceremony</p>
                    <h2 id="programme-title" tabindex="-1">Order of the day</h2>
                </header>
                <ol class="events">
                    @for (var i = 0; i < Config.Programme.Count; i++)
                    {
                        var item = Config.Programme[i];
                        <li class="event" style="--i:@i">
                            <span class="event-step" aria-hidden="true">@(i + 1)</span>
                            <div class="event-media"><WeddingIllustration Kind="@ProgrammeArt(item.Title)" /></div>
                            <div class="event-body"><div class="event-time"><LocalTime Value="item.Start" /></div><h3 class="event-title">@item.Title</h3><p class="event-desc">@item.Description</p></div>
                        </li>
                    }
                </ol>
                @if (Config.Programme.Count == 0)
                {
                    <p class="events-empty">The programme will be shared soon.</p>
                }
            </div>
            <nav class="programme-bar" aria-label="Programme navigation">
                <button class="btn ghost" type="button" @onclick="ReturnToCards">‹ Invitation</button>
                <button class="btn" type="button" @onclick="OpenDetails">Wedding details →</button>
            </nav>
        </section>
        <section class="details-screen" hidden="@(_screen != Screen.Details)" aria-labelledby="details-title">
            <header class="details-heading">
                <p class="eyebrow">@Config.CoupleNames</p>
                <h2 id="details-title" tabindex="-1">A day to remember</h2>
                <p class="wedding-blessing">@Config.BlessingText</p>
            </header>
            <div class="details-grid">
                <section class="details-date" aria-labelledby="date-title">
                    <h3 id="date-title" class="wedding-date"><span class="date-day">@_dateParts[0]</span><span class="date-number">@_dateParts[1]</span><span class="date-month">@_dateParts[2]</span></h3>
                    <p class="ceremony-time">Ceremony at <time datetime="@Config.Wedding.Start.ToString("O")">@_dateParts[3]</time></p>
                    <p class="quiet">Celebration ends <LocalTime Value="Config.Wedding.End" /></p>
                    <p class="quiet">Times are local to you. Venue timezone: @Config.Wedding.TimeZone.</p>
                    <Countdown Target="Config.Wedding.Start" Label="Until our wedding" ExpiredText="Our wedding day has arrived" />
                    <CalendarLinks Config="Config" />
                </section>
                <section class="venue-details" aria-labelledby="venue-title">
                    <WeddingIllustration Kind="venue" />
                    <p class="eyebrow">Join us here</p>
                    <h3 id="venue-title">@Config.Wedding.VenueName</h3>
                    <address>@Config.Wedding.Address</address>
                    @if (!string.IsNullOrWhiteSpace(Config.Wedding.MapUrl))
                    {
                        <a class="button directions-button" href="@Config.Wedding.MapUrl" target="_blank" rel="noopener noreferrer" aria-describedby="directions-help">
                            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true" focusable="false"><path d="M12 22s8-7 8-13a8 8 0 0 0-16 0c0 6 8 13 8 13z" /><circle cx="12" cy="9" r="3" /></svg>
                            Get directions ↗
                        </a>
                        <p id="directions-help" class="quiet">Opens Maps in a new tab. Choose your starting point and travel mode for a route to the venue.</p>
                    }
                </section>
            </div>
            <nav class="details-navigation" aria-label="Wedding details navigation">
                <button class="btn ghost" type="button" @onclick="OpenProgramme">‹ Programme</button>
                <button class="btn" type="button" @onclick="OpenRsvp">Continue to RSVP →</button>
            </nav>
        </section>
        @* Keep the v2 form mounted after first use so Back does not discard edits. *@
        @if (_rsvpVisited)
        {
            <section class="original-rsvp-screen" hidden="@(_screen != Screen.Rsvp)" aria-label="Wedding RSVP">
                <div class="rsvp-ornament" id="rsvp-screen-title" tabindex="-1"><span class="sr-only">Wedding RSVP</span><span aria-hidden="true">✦ ❀ ✦</span></div>
                <RsvpPanel Config="Config" />
                <button class="button-subtle" type="button" @onclick="OpenDetails">← Back to wedding details</button>
                <p class="quiet">Your invitation link is private. Please share it only with your household.</p>
            </section>
        }
    </main>
</div>

<dialog id="invitation-viewer" class="invitation-viewer" @ref="_viewer" aria-labelledby="viewer-title" @onclose="ViewerClosed">
    <div class="viewer-tools">
        <h2 id="viewer-title" class="sr-only">Wedding invitation, enlarged</h2>
        <button class="btn ghost" type="button" aria-pressed="@_zoomed" aria-controls="viewer-artwork" @onclick="ToggleZoomAsync">@(_zoomed ? "Fit to screen" : "Zoom in")</button>
        <button class="btn ghost viewer-close" type="button" @onclick="CloseViewerAsync" autofocus>Close</button>
    </div>
    <div id="viewer-artwork" class="viewer-scroll @(_zoomed ? "is-zoomed" : "")" tabindex="0" role="region" aria-label="Enlarged artwork; scroll or swipe to explore when zoomed">
        <img class="viewer-img" src="@Config.InvitationImage" alt="Wedding invitation for @Config.CoupleNames, enlarged" draggable="false" />
    </div>
</dialog>

@code {
    [Parameter, EditorRequired] public AppConfiguration Config { get; set; } = new();
    private enum Screen { Cards, Programme, Details, Rsvp }
    private Screen _screen;
    private bool _opened, _cardsVisible, _dateRevealed, _rsvpVisited, _zoomed;
    private int _card;
    private string? _focusTarget;
    private double _touchX, _touchY;
    private bool _trackingTouch, _scrollToTop;
    private readonly CancellationTokenSource _lifetime = new();
    private Task<IJSObjectReference>? _moduleTask;
    private ElementReference _presentation, _viewer, _petals;
    private IJSObjectReference? _petalSession;
    private IJSObjectReference? _illustrations;
    private Task<IJSObjectReference> Module => _moduleTask ??= JS.InvokeAsync<IJSObjectReference>("import", "./js/original-design.js").AsTask();
    private string[] _dateParts = ["", "", "", ""];
    private static string ProgrammeArt(string title) => title switch
    {
        var text when text.Contains("thaali", StringComparison.OrdinalIgnoreCase) || text.Contains("தாலி") => "thaali",
        var text when text.Contains("ceremon", StringComparison.OrdinalIgnoreCase) => "lamp",
        var text when text.Contains("virundhu", StringComparison.OrdinalIgnoreCase) || text.Contains("feast", StringComparison.OrdinalIgnoreCase) => "feast",
        var text when text.Contains("celebration", StringComparison.OrdinalIgnoreCase) || text.Contains("photo", StringComparison.OrdinalIgnoreCase) => "dancing",
        _ => "lotus"
    };

    // Focus without replacing the private #invite=... fragment.
    private Task FocusMainAsync() => Browser.FocusAsync("invitation-main");

    private async Task OpenAsync()
    {
        if (_opened) return;
        _opened = true;
        try
        {
            var reduced = await (await Module).InvokeAsync<bool>("prefersReducedMotion");
            await Task.Delay(reduced ? 1 : 2700, _lifetime.Token);
            _cardsVisible = true;
            _focusTarget = "card-label";
        }
        catch (OperationCanceledException) { }
    }

    private void RevealDate()
    {
        _dateRevealed = true;
        _focusTarget = "reveal-status";
    }
    private async Task ShowViewerAsync()
    {
        _zoomed = false;
        await (await Module).InvokeVoidAsync("showDialog", _viewer);
    }
    private async Task CloseViewerAsync() => await (await Module).InvokeVoidAsync("closeDialog", _viewer);
    private void ViewerClosed() { _zoomed = false; _focusTarget = "invitation-enlarge"; }
    private async Task ToggleZoomAsync()
    {
        _zoomed = !_zoomed;
        await (await Module).InvokeVoidAsync("resetViewerScroll", _viewer);
    }
    private void PreviousCard() { _card = 0; _zoomed = false; _focusTarget = "card-label"; }
    private void Next()
    {
        if (_card == 0 && !_dateRevealed) { RevealDate(); return; }
        if (_card == 0) ReturnToCards();
        else OpenProgramme();
    }
    private void Navigate(Screen screen, string target) { _screen = screen; _focusTarget = target; _scrollToTop = true; _trackingTouch = false; }
    private void OpenProgramme() => Navigate(Screen.Programme, "programme-title");
    private void OpenDetails() => Navigate(Screen.Details, "details-title");
    private void OpenRsvp() { _rsvpVisited = true; Navigate(Screen.Rsvp, "rsvp-screen-title"); }
    private void ReturnToCards() { _card = 1; Navigate(Screen.Cards, "invitation-title"); }
    private void TouchStart(TouchEventArgs e)
    {
        _trackingTouch = e.Touches.Length == 1 && !_zoomed && _dateRevealed;
        if (_trackingTouch) { _touchX = e.Touches[0].ClientX; _touchY = e.Touches[0].ClientY; }
    }
    private void TouchEnd(TouchEventArgs e)
    {
        if (!_trackingTouch || e.ChangedTouches.Length == 0) return;
        _trackingTouch = false;
        var dx = e.ChangedTouches[0].ClientX - _touchX;
        var dy = e.ChangedTouches[0].ClientY - _touchY;
        if (Math.Abs(dx) < 60 || Math.Abs(dx) < Math.Abs(dy) * 1.5) return;
        if (dx < 0) Next(); else PreviousCard();
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _petalSession = await (await Module).InvokeAsync<IJSObjectReference>("attachPetals", _petals);
            _dateParts = await (await Module).InvokeAsync<string[]>("localDateParts", Config.Wedding.Start.ToString("O"));
            _illustrations = await (await Module).InvokeAsync<IJSObjectReference>("observeIllustrations", _presentation);
            StateHasChanged();
        }
        if (_focusTarget is { } target)
        {
            _focusTarget = null;
            if (_scrollToTop)
            {
                _scrollToTop = false;
                await (await Module).InvokeVoidAsync("focusPage", target);
            }
            else await Browser.FocusAsync(target);
        }
    }
    public async ValueTask DisposeAsync()
    {
        await _lifetime.CancelAsync();
        if (_petalSession is not null)
        {
            await _petalSession.InvokeVoidAsync("dispose");
            await _petalSession.DisposeAsync();
        }
        if (_illustrations is not null)
        {
            await _illustrations.InvokeVoidAsync("dispose");
            await _illustrations.DisposeAsync();
        }
        if (_moduleTask is not null) await (await _moduleTask).DisposeAsync();
        _lifetime.Dispose();
    }
}
