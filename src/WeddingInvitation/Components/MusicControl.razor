@inject BrowserService Browser

@if (!string.IsNullOrWhiteSpace(Config.MusicUrl))
{
    <div class="music-control">
        <button type="button" class="button-subtle" data-music-toggle aria-pressed="false" aria-label="Play or pause background music">♫ Music</button>
        <span class="sr-only" data-music-status role="status"></span>
    </div>
}

@code {
    [Parameter, EditorRequired] public AppConfiguration Config { get; set; } = new();
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !string.IsNullOrWhiteSpace(Config.MusicUrl))
            await Browser.PrepareMusicAsync(Config.MusicUrl, Config.MusicVolume);
    }
}
