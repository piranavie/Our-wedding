@inject IConfigurationService Configuration

<ErrorBoundary>
    <ChildContent>
        @if (_configuration is not null)
        {
            <PageTitle>@_configuration.CoupleNames · @_configuration.Wedding.Title</PageTitle>
            <InvitationPage Config="_configuration" />
        }
        else if (_error is not null)
        {
            <main class="loading-panel"><h1>Our wedding invitation</h1><p role="alert">@_error</p><button onclick="location.reload()">Try again</button></main>
        }
        else
        {
            <main class="loading-panel" aria-busy="true"><h1>A beautiful beginning</h1><p role="status">Preparing your invitation…</p></main>
        }
    </ChildContent>
    <ErrorContent>
        <main class="loading-panel"><h1>We couldn’t display the invitation</h1><p>Please reload the page. If this continues, contact the couple.</p><button onclick="location.reload()">Reload invitation</button></main>
    </ErrorContent>
</ErrorBoundary>

@code {
    private AppConfiguration? _configuration;
    private string? _error;
    protected override async Task OnInitializedAsync()
    {
        try { _configuration = await Configuration.LoadAsync(); }
        catch (Exception) { _error = "The invitation settings could not be loaded. Check your connection or contact the couple."; }
    }
}
